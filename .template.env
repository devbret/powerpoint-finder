API_KEY=your-google-api-key-here
CX=your-custom-search-engine-id-here

API_ENDPOINT=https://www.googleapis.com/customsearch/v1

OUT_DIR=powerpoint_downloads
MANIFEST_DIR=manifests

USER_AGENT=powerpoint-finder/1.0

QUERIES=keyword searches here, keyword searches here

BLOCKED_DOWNLOAD_DOMAINS=["example.com","example.org","example.net"]

PAGES=1
DELAY=0.0
TIMEOUT=60